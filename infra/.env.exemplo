# Copiado para .env por infra/subir.sh, que preenche os valores TROCAR.
TEMPORAL_VERSAO=1.32.0
# Padrão de cada organização nova; cada uma muda o seu na tela de Armazenamento.
RETENCAO_DIAS=180
# Por quanto tempo a cópia fria diária fica guardada, para toda a instalação. Organização removida só sai das cópias quando elas vencem.
ROAR_ARQUIVO_DIAS=365
POSTGRES_SENHA=TROCAR
BANCO_SENHA=TROCAR
ROAR_INGESTAO_SENHA=TROCAR
ROAR_API_SENHA=TROCAR
ROAR_LEITOR_SENHA=TROCAR
ROAR_UEBA_SENHA=TROCAR
ROAR_SOAR_SENHA=TROCAR
ROAR_MFA_CHAVE=TROCAR
ROAR_SELO_ANCORA=1
# Armazém de eventos (ClickHouse): senha do administrador, senha de leitura e dias no disco rápido antes do frio.
ARMAZEM_SENHA=TROCAR
ARMAZEM_LEITOR_SENHA=TROCAR
ARMAZEM_DIAS_QUENTES=30
# Porta HTTP do armazém em 127.0.0.1. Troque se a máquina já tiver outro ClickHouse na 8123.
ARMAZEM_PORTA=8123
# Pastas do disco frio e da cópia fria do armazém, se forem num disco à parte (vazias usam /opt/panthera-roar).
ARMAZEM_FRIO=
ARMAZEM_COPIAS=
# Alertas lidos do armazém, gravados em lote, em vez do indexador (1 liga). O Postgres guarda só os últimos dias.
ROAR_ALERTAS_DO_ARMAZEM=1
ROAR_DIAS_DE_ALERTAS=90
# Selos de integridade calculados sobre o armazém, em vez do indexador (1 liga), para quem já tem o armazém.
ROAR_SELOS_DO_ARMAZEM=1
# Logs e alertas só no armazém: o Filebeat dos gerenciadores não sobe, e o indexador fica só com o estado do Wazuh.
ROAR_SO_ARMAZEM=1
