<!--
  Regras do Panthera Roar para os decodificadores de fabricantes (decodificadores.xml). Faixa reservada: 100910 a 100929.
-->
<group name="roar,fabricantes,mikrotik,">

  <rule id="100910" level="3">
    <decoded_as>roar-mikrotik</decoded_as>
    <field name="cadeia">\.+</field>
    <description>MikroTik: firewall registrou conexão de $(srcip) para $(dstip) ($(cadeia))</description>
    <group>firewall,</group>
  </rule>

  <!-- Filha da regra genérica de falha de autenticação do Wazuh, que pega "login failure" antes de qualquer regra nova. -->
  <rule id="100911" level="5">
    <if_sid>2501</if_sid>
    <decoded_as>roar-mikrotik</decoded_as>
    <match>login failure for user</match>
    <description>MikroTik: login recusado para $(dstuser) vindo de $(srcip) ($(metodo))</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100912" level="3">
    <decoded_as>roar-mikrotik</decoded_as>
    <match>logged in from</match>
    <description>MikroTik: $(dstuser) entrou vindo de $(srcip) ($(metodo))</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100913" level="10" frequency="6" timeframe="120">
    <if_matched_sid>100911</if_matched_sid>
    <same_source_ip />
    <description>MikroTik: muitas tentativas de login recusadas vindas de $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

</group>
